# 复制本文件为 .env 后填写（本地运行时使用；GitHub Actions 用 Secrets/Variables 配置）

# ===== 必填：微信推送 =====
# PushPlus token，在 https://www.pushplus.plus 微信扫码登录后可获取
PUSHPLUS_TOKEN=

# ===== 可选：静态站点根地址（用于推送消息中附带的 PDF / 网页链接）=====
# GitHub Pages 示例：https://你的用户名.github.io/仓库名
REPORT_BASE_URL=

# ===== 可选：LLM 深度分析（不填则使用零成本规则模板）=====
# OpenAI 兼容接口的 API Key
LLM_API_KEY=
# 接口地址，默认 DeepSeek（便宜）；也可填 OpenRouter / 腾讯云 TokenHub
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
